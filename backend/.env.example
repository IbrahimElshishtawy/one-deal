# Market Space Backend Environment Variables (Example & Placeholders)

NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000/api/v1
# Required in production (explicit comma-separated origins, no wildcard '*')
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
# Trusted proxy boundary: 'false', exact hop count (e.g. '1' on Railway), 'loopback', or IP/CIDR list. Never 'true'.
TRUST_PROXY=false
# Bearer / X-Metrics-Token required to scrape /metrics in production
METRICS_AUTH_TOKEN=

# Configurable Authentication Rate Limits
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SEC=900
RATE_LIMIT_REFRESH_MAX=20
RATE_LIMIT_REFRESH_WINDOW_SEC=900
RATE_LIMIT_OTP_VERIFY_MAX=10
RATE_LIMIT_OTP_VERIFY_WINDOW_SEC=900

# Database & PgBouncer Pooling
DATABASE_URL=postgresql://marketspace_app:secretpassword@localhost:5432/marketspace?schema=public
DATABASE_CONNECTION_LIMIT=10
PGBOUNCER_ENABLED=false

# Runtime Feature Flags
ENABLE_SWAGGER=true
ENABLE_WORKERS=true
AUTO_APPROVE_LISTINGS=false
AUDIT_QUEUE_ENABLED=false
SENTRY_DSN=

# Redis Infrastructure (Separated Cache & Queue Instances)
REDIS_CACHE_HOST=localhost
REDIS_CACHE_PORT=6379
REDIS_CACHE_PASSWORD=

REDIS_QUEUE_HOST=localhost
REDIS_QUEUE_PORT=6380
REDIS_QUEUE_PASSWORD=

# Legacy Redis Compatibility
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & JWT Tokens
JWT_ACCESS_SECRET=replace_with_64_character_hex_secret_in_production
JWT_REFRESH_SECRET=replace_with_64_character_hex_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SMS & WhatsApp OTP Gateways (Egypt)
# Supported SMS_PROVIDER values: SMS_MISR | WHATSAPP | WHATSAPP_CLOUD
SMS_PROVIDER=SMS_MISR
SMS_MISR_USERNAME=placeholder_username
SMS_MISR_PASSWORD=placeholder_password
SMS_MISR_SENDER_ID=MarketSpace

# Meta WhatsApp Cloud API (when SMS_PROVIDER=WHATSAPP)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=auth_otp
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_API_VERSION=v21.0
WHATSAPP_INCLUDE_COPY_BUTTON=true
WHATSAPP_FALLBACK_TO_SMS=false

# Storage (Cloudflare R2 / S3 Compatible)
R2_ACCOUNT_ID=placeholder_r2_account_id
R2_ACCESS_KEY_ID=placeholder_r2_access_key
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_key
R2_BUCKET_NAME=marketspace-media-dev
R2_PUBLIC_DOMAIN=https://cdn.marketspace.eg

# Video Service (Cloudflare Stream)
CLOUDFLARE_STREAM_API_TOKEN=placeholder_stream_api_token
CLOUDFLARE_STREAM_ACCOUNT_ID=placeholder_stream_account_id
CLOUDFLARE_STREAM_WEBHOOK_SECRET=placeholder_stream_webhook_secret

# Payments (Paymob Egypt)
PAYMOB_API_KEY=placeholder_paymob_api_key
PAYMOB_INTEGRATION_ID_CARD=123456
PAYMOB_INTEGRATION_ID_WALLET=123457
PAYMOB_HMAC_SECRET=placeholder_paymob_hmac_secret

# Push Notifications (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID=marketspace-dev
FIREBASE_CLIENT_EMAIL=placeholder@marketspace-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=placeholder_private_key
ENABLE_V2_PAYMENTS=false
