  @@map("rfq_items")
}

model Quotation {
  id                    String   @id @default(uuid()) @db.Uuid
  rfqId                 String   @map("rfq_id") @db.Uuid
  supplierAccountId     String   @map("supplier_account_id") @db.Uuid
  submittedByUserId     String   @map("submitted_by_user_id") @db.Uuid
  subtotalAmount        Decimal  @map("subtotal_amount") @db.Decimal(14, 2)
  deliveryFee           Decimal  @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  totalAmount           Decimal  @map("total_amount") @db.Decimal(14, 2)
  currency              String   @default("EGP") @db.VarChar(3)
  estimatedDeliveryDays Int      @map("estimated_delivery_days")
  validUntil            DateTime @map("valid_until") @db.Timestamptz
  notes                 String?  @db.Text
  status                String   @default("SUBMITTED") @db.VarChar(20)
  statusReason          String?  @map("status_reason") @db.Text
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  rfq             RfqRequest      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  acceptedForRfq  RfqRequest?     @relation("RfqAcceptedQuotation")
  supplierAccount Account         @relation("SupplierQuotations", fields: [supplierAccountId], references: [id], onDelete: Restrict)
  submittedBy     User            @relation("UserSubmittedQuotations", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  items           QuotationItem[]

  @@unique([rfqId, supplierAccountId], name: "uq_rfq_supplier_quotation")
  @@index([rfqId, status])
  @@index([status, validUntil])
  @@index([supplierAccountId, createdAt(sort: Desc)])
  @@map("quotations")
}

model QuotationItem {
  id          String  @id @default(uuid()) @db.Uuid
  quotationId String  @map("quotation_id") @db.Uuid
  rfqItemId   String? @map("rfq_item_id") @db.Uuid
  name        String  @db.VarChar(200)
  quantity    Decimal @db.Decimal(12, 3)
  unit        String  @db.VarChar(40)
  unitPrice   Decimal @map("unit_price") @db.Decimal(14, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(14, 2)
  notes       String? @db.Text

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqItem   RfqItem?  @relation(fields: [rfqItemId], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@map("quotation_items")
}

model CartItem {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  listingId         String   @map("listing_id") @db.Uuid
  quantity          Int      @default(1)
  variantKey        String   @default("default") @map("variant_key") @db.VarChar(100)
  variantAttributes Json     @default("{}") @map("variant_attributes")
  unitPriceSnapshot Decimal  @map("unit_price_snapshot") @db.Decimal(14, 2)
  currency          String   @default("EGP") @db.VarChar(3)
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId, variantKey], name: "uq_cart_user_listing_variant")
  @@index([userId, updatedAt(sort: Desc)])
  @@index([listingId])
  @@map("cart_items")
}

